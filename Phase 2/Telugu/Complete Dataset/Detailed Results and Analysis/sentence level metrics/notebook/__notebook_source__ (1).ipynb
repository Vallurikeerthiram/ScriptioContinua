from bert_score import score as bert_score

def clean_text(value: object) -> str:
    """Normalize and clean text strings, handling NaN/null values gracefully."""
    if pd.isna(value):
        return ""
    text = str(value).strip()
    return "" if text.lower() in {"nan", "none", "<na>"} else text

def parse_labels(value: object) -> List[str]:
    """Parse label sequence into individual tokens or character tags."""
    text = clean_text(value)
    if not text:
        return []
    tokens = text.split()
    return tokens if len(tokens) > 1 else [c for c in text if not c.isspace()]

def compute_sentence_bleu(reference: str, candidate: str, max_n: int = 4) -> float:
    """
    Sentence-level BLEU with Laplace smoothing to prevent zero scores
    on shorter Telugu sentences.
    """
    ref_tokens = str(reference).strip().split()
    cand_tokens = str(candidate).strip().split()
    ref_length = len(ref_tokens)
    cand_length = len(cand_tokens)

    if cand_length == 0 or ref_length == 0:
        return 0.0

    clipped_counts = [0] * max_n
    total_counts = [0] * max_n

    for n in range(1, max_n + 1):
        if len(ref_tokens) < n:
            ref_ng: Dict[Tuple[str, ...], int] = {}
        else:
            ref_ng = {}
            for i in range(len(ref_tokens) - n + 1):
                g = tuple(ref_tokens[i : i + n])
                ref_ng[g] = ref_ng.get(g, 0) + 1

        if len(cand_tokens) < n:
            cand_ng: Dict[Tuple[str, ...], int] = {}
        else:
            cand_ng = {}
            for i in range(len(cand_tokens) - n + 1):
                g = tuple(cand_tokens[i : i + n])
                cand_ng[g] = cand_ng.get(g, 0) + 1

        total_counts[n - 1] += max(sum(cand_ng.values()), 1)
        clipped_counts[n - 1] += sum(min(count, ref_ng.get(gram, 0)) for gram, count in cand_ng.items())

    precisions = [(clip + 1.0) / (total + 1.0) for clip, total in zip(clipped_counts, total_counts)]
    geo_mean = math.exp(sum(math.log(p) for p in precisions) / max_n)
    brevity_penalty = 1.0 if cand_length > ref_length else math.exp(1.0 - (ref_length / cand_length))
    return float(geo_mean * brevity_penalty)

def lcs_length(a: Sequence[str], b: Sequence[str]) -> int:
    """Memory-efficient 1D dynamic programming Longest Common Subsequence."""
    if not a or not b:
        return 0
    if len(a) < len(b):
        a, b = b, a
    prev = [0] * (len(b) + 1)
    for elem_a in a:
        curr = [0] * (len(b) + 1)
        for j, elem_b in enumerate(b, 1):
            if elem_a == elem_b:
                curr[j] = prev[j - 1] + 1
            else:
                curr[j] = prev[j] if prev[j] > curr[j - 1] else curr[j - 1]
        prev = curr
    return prev[-1]

def compute_sentence_rouge(reference: str, candidate: str) -> Tuple[float, float, float]:
    """
    Computes per-sentence ROUGE-1 F1, ROUGE-2 F1, and ROUGE-L F1.
    """
    ref_tokens = str(reference).strip().split()
    cand_tokens = str(candidate).strip().split()
    len_ref = len(ref_tokens)
    len_cand = len(cand_tokens)
    if len_ref == 0 or len_cand == 0:
        return 0.0, 0.0, 0.0

    # ROUGE-1
    ref_1 = Counter(ref_tokens)
    cand_1 = Counter(cand_tokens)
    overlap_1 = sum(min(count, cand_1.get(w, 0)) for w, count in ref_1.items())
    p1 = overlap_1 / len_cand
    r1 = overlap_1 / len_ref
    f1_1 = (2 * p1 * r1 / (p1 + r1)) if (p1 + r1) else 0.0

    # ROUGE-2
    if len_ref > 1 and len_cand > 1:
        ref_2 = Counter(tuple(ref_tokens[i : i + 2]) for i in range(len_ref - 1))
        cand_2 = Counter(tuple(cand_tokens[i : i + 2]) for i in range(len_cand - 1))
        overlap_2 = sum(min(count, cand_2.get(g, 0)) for g, count in ref_2.items())
        p2 = overlap_2 / (len_cand - 1)
        r2 = overlap_2 / (len_ref - 1)
        f1_2 = (2 * p2 * r2 / (p2 + r2)) if (p2 + r2) else 0.0
    else:
        f1_2 = 0.0

    # ROUGE-L
    lcs = lcs_length(ref_tokens, cand_tokens)
    pl = lcs / len_cand
    rl = lcs / len_ref
    f1_l = (2 * pl * rl / (pl + rl)) if (pl + rl) else 0.0

    return f1_1, f1_2, f1_l

def compute_meteor_score(reference: str, candidate: str) -> float:
    """
    Computes per-sentence METEOR score with harmonic mean precision & recall.
    """
    ref_tokens = str(reference).strip().split()
    cand_tokens = str(candidate).strip().split()
    if not ref_tokens or not cand_tokens:
        return 0.0
    ref_counter = Counter(ref_tokens)
    cand_counter = Counter(cand_tokens)
    matches = sum(min(ref_counter[token], cand_counter[token]) for token in ref_counter)
    if matches == 0:
        return 0.0
    precision = matches / len(cand_tokens)
    recall = matches / len(ref_tokens)
    return float((10 * precision * recall / (recall + 9 * precision)) if (recall + 9 * precision) else 0.0)

def compute_sentence_classification_metrics(
    true_labels_raw: object, pred_labels_raw: object
) -> Tuple[float, float, float, float]:
    """
    Computes per-sentence sequence classification metrics:
    F1, PRECISION, ACCURACY, RECALL.
    """
    y_true = parse_labels(true_labels_raw)
    y_pred = parse_labels(pred_labels_raw)
    limit = min(len(y_true), len(y_pred))
    if limit == 0:
        return 0.0, 0.0, 0.0, 0.0
    yt = y_true[:limit]
    yp = y_pred[:limit]

    labels = sorted(set(yt) | set(yp))
    total_acc = sum(1 for a, b in zip(yt, yp) if a == b) / limit

    prec_sum, rec_sum, f1_sum = 0.0, 0.0, 0.0
    for l in labels:
        tp = sum(1 for a, b in zip(yt, yp) if a == l and b == l)
        fp = sum(1 for a, b in zip(yt, yp) if a != l and b == l)
        fn = sum(1 for a, b in zip(yt, yp) if a == l and b != l)
        p = tp / (tp + fp) if (tp + fp) else 0.0
        r = tp / (tp + fn) if (tp + fn) else 0.0
        f = (2 * p * r / (p + r)) if (p + r) else 0.0
        prec_sum += p
        rec_sum += r
        f1_sum += f
    n = len(labels)
    return f1_sum / n, prec_sum / n, total_acc, rec_sum / n

def compute_fast_bertscore(
    candidates: Sequence[str],
    references: Sequence[str],
    model_type: str = "bert-base-multilingual-cased",
    batch_size: int = 128,
    device: str = "cuda:0" if torch.cuda.is_available() else "cpu",
) -> Tuple[np.ndarray, np.ndarray, np.ndarray]:
    """
    High-throughput GPU batch BERTScore calculation for Telugu text.
    Returns per-sentence (P, R, F1) numpy arrays.
    """
    cands = [str(c) if clean_text(c) else " " for c in candidates]
    refs = [str(r) if clean_text(r) else " " for r in references]
    
    start_t = time.time()
    P, R, F1 = bert_score(
        cands,
        refs,
        model_type=model_type,
        device=device,
        batch_size=batch_size,
        verbose=False,
    )
    elapsed = time.time() - start_t
    rate = len(cands) / max(elapsed, 0.001)
    print(f"    [GPU BERTScore] {len(cands):,} sentences in {elapsed:.1f}s ({rate:.1f} sent/s)")
    
    return P.cpu().numpy(), R.cpu().numpy(), F1.cpu().numpy()





def get_model_meta(file_path: Path) -> Tuple[str, str]:
    """
    Identifies the State Model Title and exact output workbook name.
    1. Telugu 2 state model predictions detailed results
    2. Telugu 4 state model predictions detailed results
    3. Telugu 4 state + CRF model predictions detailed results
    """
    name = file_path.stem.lower()
    if "2state" in name or "2_state" in name:
        return "Telugu 2-State", "telugu_2_state_model_predictions_detailed_results.xlsx"
    elif "4state_crf" in name or "4_state_crf" in name or ("4state" in name and "crf" in name):
        return "Telugu 4-State + CRF", "telugu_4_state_crf_model_predictions_detailed_results.xlsx"
    elif "4state" in name or "4_state" in name:
        return "Telugu 4-State", "telugu_4_state_model_predictions_detailed_results.xlsx"
    else:
        return file_path.stem, f"{file_path.stem}_detailed_results.xlsx"

def normalize_split_name(sheet_name: str) -> str:
    """
    Normalizes sheet names into standard keys: 'train', 'test', 'Evaluation'.
    """
    s = str(sheet_name).strip().upper()
    if "TRAIN" in s:
        return "train"
    elif "TEST" in s:
        return "test"
    elif "VAL" in s or "EVAL" in s:
        return "Evaluation"
    return sheet_name

REQUIRED_INPUT_COLS = [
    "Art_id", "para_id", "Sent_id", "INPUT_SENTENCE", "GROUND_TRUTH_SENTENCE",
    "PREDICTED_SENTENCE", "GROUND_TRUTH_LABELS", "PREDICTED_LABELS", "MODEL", "SPLIT"
]

METRIC_COLS = [
    "BLEU", "ROUGE_1_F1", "ROUGE_2_F1", "ROUGE_L_F1", "METEOR",
    "BERTSCORE_P", "BERTSCORE_R", "BERTSCORE_F1", "F1", "PRECISION", "ACCURACY", "RECALL"
]

ALL_SHEET_COLS = REQUIRED_INPUT_COLS + METRIC_COLS

def evaluate_workbook_splits(
    file_path: Path,
    bert_model: str = "bert-base-multilingual-cased",
    batch_size: int = 128,
) -> Tuple[str, str, Dict[str, pd.DataFrame], pd.DataFrame]:
    """
    Evaluates an entire workbook across Train, Test, and Evaluation splits.
    Returns:
      state_name, out_filename, {split_name: detailed_df}, file_summary_df
    """
    state_name, out_filename = get_model_meta(file_path)
    print("\n" + "=" * 80)
    print(f"PROCESSING: {state_name} ({file_path.name})")
    print("=" * 80)

    xl = pd.ExcelFile(file_path)
    print(f"Available Sheets in Workbook: {xl.sheet_names}")

    split_dfs: Dict[str, pd.DataFrame] = {}
    summary_rows: List[Dict[str, object]] = []

    # Map sheets to train, test, Evaluation
    sheet_map: Dict[str, str] = {}
    for s in xl.sheet_names:
        norm = normalize_split_name(s)
        sheet_map[norm] = s

    ordered_splits = ["train", "test", "Evaluation"]

    for split_key in ordered_splits:
        if split_key not in sheet_map:
            print(f"[!] Warning: Split '{split_key}' not found in {file_path.name}. Creating empty split.")
            empty_df = pd.DataFrame(columns=ALL_SHEET_COLS)
            split_dfs[split_key] = empty_df
            continue

        raw_sheet = sheet_map[split_key]
        print(f"\n--- Loading Split [{split_key}] from Sheet [{raw_sheet}] ---")
        df = xl.parse(raw_sheet, dtype=str)

        # Standardize column casing
        canonical_map = {
            "art_id": "Art_id",
            "para_id": "para_id",
            "sent_id": "Sent_id",
            "input_sentence": "INPUT_SENTENCE",
            "ground_truth_sentence": "GROUND_TRUTH_SENTENCE",
            "predicted_sentence": "PREDICTED_SENTENCE",
            "ground_truth_labels": "GROUND_TRUTH_LABELS",
            "predicted_labels": "PREDICTED_LABELS",
            "model": "MODEL",
            "split": "SPLIT",
        }
        df.rename(columns={c: canonical_map[c.lower()] for c in df.columns if c.lower() in canonical_map}, inplace=True)

        if "SPLIT" not in df.columns or df["SPLIT"].isna().all():
            df["SPLIT"] = split_key.upper()
        if "MODEL" not in df.columns:
            df["MODEL"] = "UNKNOWN"

        for col in ["GROUND_TRUTH_SENTENCE", "PREDICTED_SENTENCE", "GROUND_TRUTH_LABELS", "PREDICTED_LABELS"]:
            if col in df.columns:
                df[col] = df[col].map(clean_text)
            else:
                df[col] = ""

        total_rows = len(df)
        print(f"Total Rows: {total_rows:,} | Models: {df['MODEL'].unique().tolist()}")

        if total_rows == 0:
            for m in METRIC_COLS:
                df[m] = 0.0
            split_dfs[split_key] = df[ALL_SHEET_COLS]
            continue

        # 1. GPU Multilingual BERTScore in high-speed batches
        print("  -> Calculating GPU Multilingual BERTScore...")
        cands = df["PREDICTED_SENTENCE"].tolist()
        refs = df["GROUND_TRUTH_SENTENCE"].tolist()
        P, R, F1 = compute_fast_bertscore(
            candidates=cands,
            references=refs,
            model_type=bert_model,
            batch_size=batch_size,
            device=device,
        )
        df["BERTSCORE_P"] = P
        df["BERTSCORE_R"] = R
        df["BERTSCORE_F1"] = F1

        # 2. Sentence-Level Generation & Sequence Metrics
        print("  -> Calculating Sentence-Level BLEU, ROUGE (1/2/L), METEOR, F1, Precision, Accuracy, Recall...")
        bleu_list: List[float] = []
        r1_list: List[float] = []
        r2_list: List[float] = []
        rl_list: List[float] = []
        meteor_list: List[float] = []
        f1_list: List[float] = []
        prec_list: List[float] = []
        acc_list: List[float] = []
        rec_list: List[float] = []

        for row in df.itertuples(index=False):
            ref = str(getattr(row, "GROUND_TRUTH_SENTENCE", "") or "")
            cand = str(getattr(row, "PREDICTED_SENTENCE", "") or "")
            gt_lbl = getattr(row, "GROUND_TRUTH_LABELS", "")
            pr_lbl = getattr(row, "PREDICTED_LABELS", "")

            # BLEU
            bleu_list.append(compute_sentence_bleu(ref, cand))

            # ROUGE 1 / 2 / L
            r1, r2, rl = compute_sentence_rouge(ref, cand)
            r1_list.append(r1)
            r2_list.append(r2)
            rl_list.append(rl)

            # METEOR
            meteor_list.append(compute_meteor_score(ref, cand))

            # Sequence Classification Metrics
            f1, p, acc, r = compute_sentence_classification_metrics(gt_lbl, pr_lbl)
            f1_list.append(f1)
            prec_list.append(p)
            acc_list.append(acc)
            rec_list.append(r)

        df["BLEU"] = bleu_list
        df["ROUGE_1_F1"] = r1_list
        df["ROUGE_2_F1"] = r2_list
        df["ROUGE_L_F1"] = rl_list
        df["METEOR"] = meteor_list
        df["F1"] = f1_list
        df["PRECISION"] = prec_list
        df["ACCURACY"] = acc_list
        df["RECALL"] = rec_list

        # Ensure all columns present and strictly ordered
        for col in ALL_SHEET_COLS:
            if col not in df.columns:
                df[col] = ""
        df = df[ALL_SHEET_COLS]
        split_dfs[split_key] = df

        # Compute summary metrics grouped by MODEL
        for model_name, group in df.groupby("MODEL", sort=True):
            summary_rows.append({
                "STATE_MODEL": state_name,
                "MODEL": model_name,
                "SPLIT": split_key,
                "ROWS": len(group),
                "BLEU": float(group["BLEU"].mean()),
                "ROUGE_1_F1": float(group["ROUGE_1_F1"].mean()),
                "ROUGE_2_F1": float(group["ROUGE_2_F1"].mean()),
                "ROUGE_L_F1": float(group["ROUGE_L_F1"].mean()),
                "METEOR": float(group["METEOR"].mean()),
                "BERTSCORE_P": float(group["BERTSCORE_P"].mean()),
                "BERTSCORE_R": float(group["BERTSCORE_R"].mean()),
                "BERTSCORE_F1": float(group["BERTSCORE_F1"].mean()),
                "F1": float(group["F1"].mean()),
                "PRECISION": float(group["PRECISION"].mean()),
                "ACCURACY": float(group["ACCURACY"].mean()),
                "RECALL": float(group["RECALL"].mean()),
            })

        # Memory cleanup
        if torch.cuda.is_available():
            torch.cuda.empty_cache()
            gc.collect()

    file_summary_df = pd.DataFrame(summary_rows)
    return state_name, out_filename, split_dfs, file_summary_df





evaluated_results = []
all_summary_frames = []

# Step 5a: Run evaluation for all available model workbooks
for target_file in resolved_files:
    state_name, out_filename, split_dfs, summary_df = evaluate_workbook_splits(
        target_file,
        bert_model=BERTSCORE_MODEL,
        batch_size=BATCH_SIZE,
    )
    evaluated_results.append((state_name, out_filename, split_dfs, summary_df))
    all_summary_frames.append(summary_df)

# Step 5b: Compile Master Summary combining all 2-state, 4-state, and 4-state+CRF models
if all_summary_frames:
    master_summary_df = pd.concat(all_summary_frames, ignore_index=True)
    # Order splits logically: train -> test -> Evaluation
    split_order = {"train": 0, "test": 1, "Evaluation": 2}
    master_summary_df["_split_order"] = master_summary_df["SPLIT"].map(lambda s: split_order.get(s, 99))
    master_summary_df.sort_values(by=["STATE_MODEL", "MODEL", "_split_order"], inplace=True)
    master_summary_df.drop(columns=["_split_order"], inplace=True)
else:
    master_summary_df = pd.DataFrame()

print("\n" + "=" * 80)
print("MASTER SUMMARY TABLE (ALL 2/4/4+CRF STATE MODELS):")
print("=" * 80)
display(master_summary_df)

# Step 5c: Save the 3 Excel workbooks, embedding the Master Summary in Sheet 4 of each
for state_name, out_filename, split_dfs, _ in evaluated_results:
    out_excel_path = OUTPUT_DIR / out_filename
    print(f"\nWriting 4-sheet workbook: {out_excel_path.name} ...")
    
    with pd.ExcelWriter(out_excel_path, engine="openpyxl") as writer:
        # Sheet 1: train
        split_dfs["train"].to_excel(writer, sheet_name="train", index=False)
        print(f"  [✓] Sheet 1 'train' written ({len(split_dfs['train']):,} rows)")
        
        # Sheet 2: test
        split_dfs["test"].to_excel(writer, sheet_name="test", index=False)
        print(f"  [✓] Sheet 2 'test' written ({len(split_dfs['test']):,} rows)")
        
        # Sheet 3: Evaluation
        split_dfs["Evaluation"].to_excel(writer, sheet_name="Evaluation", index=False)
        print(f"  [✓] Sheet 3 'Evaluation' written ({len(split_dfs['Evaluation']):,} rows)")
        
        # Sheet 4: summary
        master_summary_df.to_excel(writer, sheet_name="summary", index=False)
        print(f"  [✓] Sheet 4 'summary' written ({len(master_summary_df):,} rows)")
        
    print(f"[SUCCESS] Saved: {out_excel_path} ({out_excel_path.stat().st_size / (1024*1024):.2f} MB)")

# Step 5d: Also save master summary as standalone Excel and CSV for quick reference
master_excel = OUTPUT_DIR / "all_models_summary.xlsx"
master_csv = OUTPUT_DIR / "all_models_summary.csv"
master_summary_df.to_excel(master_excel, sheet_name="summary", index=False)
master_summary_df.to_csv(master_csv, index=False)
print(f"\n[✓] Saved Standalone Summary Excel: {master_excel}")
print(f"[✓] Saved Standalone Summary CSV  : {master_csv}")





